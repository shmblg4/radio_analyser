{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(gdb) Launch on WSL",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/radio_analyser",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Build Debug Project"
        },
        {
            "name": "(gdb) Launch on Pi Display",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/radio_analyser",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${fileDirname}",
            "environment": [
                {
                    "name": "WAYLAND_DISPLAY",
                    "value": "wayland-0"
                },
                {
                    "name": "XDG_RUNTIME_DIR",
                    "value": "/run/user/1000"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Build Debug Project"
        }
    ]
}